# Settings for Taiko's NAS server. Copy this file to .env (same folder as compose.yaml) and fill it in.
# .env stays on the host; git ignores it.

# ---- Required ----

# The address devices reach this server at. https or http, and it must end in /api/.
# The server answers under the path given here, so https://nas.example.com/taiko/api/ works too
# (the reverse proxy must then pass the /taiko/api/ path through unchanged).
# A player served over https can only call an https server.
PUBLIC_BASE=https://music.example.com/api/

# The host folder that holds your music. Compose binds it read-only at /library inside the container.
# (Read by compose.yaml, not by the server.)
LIBRARY_MOUNT=/volume1/music

# The folders to serve, as name=folder pairs separated by commas. Folders are paths inside the container, so they
# start with /library. Each name is a top-level folder in the player's browser and the first part of every path and
# track id under it (an id is the file's path, encoded), so renaming a root or moving a file makes its tracks new to
# paired devices. A name can't contain a slash.
# Listed: flac, mp3, m4a, aac, ogg, oga, opus and wav files. Never listed: names starting with a dot or @,
# #recycle and $RECYCLE.BIN. Lyrics (.lrc, .ttml, .json) are found beside a song by name:
# "Song.flac" takes "Song.lrc", "Song.ja.ttml", "Song_en.json".
LIBRARY_ROOTS=Music=/library

# ---- Optional (the values shown are the defaults) ----

# The name paired devices show for this server.
#SERVER_NAME=Taiko NAS

# The player that pairing links open, and the only web origins allowed to call this server (besides
# http://localhost and http://127.0.0.1, for development). Several players: separate them with commas;
# pairing links open the first.
#APP_URL=https://taiko-player.pages.dev/

# The library: albums and artists on the player's first screen, and its search, built from the songs' tags.
#   off          (the default) no library. Nothing is scanned; the player browses by folder.
#   on           every root in LIBRARY_ROOTS goes into the library.
#   Music,Other  only the roots named here (names from LIBRARY_ROOTS, spelled exactly, separated by commas).
# A root left out of the library is still there in the folder browser, and its songs still play: browsing reads one
# folder at a time when asked and needs no scan. A scan reads the tags of every audio file in the chosen roots
# (8 folders deep) when the server starts and again every SCAN_INTERVAL_MINUTES; a folder that directly holds songs
# is one album. So name the roots whose folders are tagged albums (Artist/Album/songs, with a cover.jpg).
#LIBRARY_SCAN=off

# Minutes between library scans. 0 scans only when the server starts (the player can also ask for a scan).
#SCAN_INTERVAL_MINUTES=360

# Pairing attempts one address may make in ten minutes, right or wrong. Raise it only if many devices pair at once.
#PAIR_ATTEMPTS=10

# The port on the host that compose publishes the server on. (Read by compose.yaml, not by the server.)
#HOST_PORT=8080

# The image name compose builds and runs. (Read by compose.yaml, not by the server.)
#TAIKO_IMAGE=taiko-server:latest

# ---- Set by compose.yaml; only for running the server without Docker ----

# The port the server listens on.
#PORT=8080

# Where the server keeps pairing codes, paired devices and its signing secret. Never inside the library.
#DATA_DIR=./data
